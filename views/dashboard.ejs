<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dashboard - Faculty Consultation Booking System</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="dashboard-header">
    <div class="header-row">
      <h1>Welcome, <%= user.name %></h1>
      <span class="brand">Faculty Consultation Booking System</span>
    </div>
    <div class="header-row">
      <p>Role: <%= user.role %></p>
      <a href="/logout" class="logout-link">Log Out</a>
    </div>
  </header>

  <main class="centered-main">
    <% if (user.role === "faculty") { %>
      <ul>
        <li><a href="/slots/new">Post a New Consultation Slot</a></li>
        <li><a href="/my-slots">My Posted Slots</a></li>
        <li><a href="/faculty-bookings">Manage Incoming Bookings</a></li>
      </ul>
    <% } else if (user.role === "student") { %>
      <ul>
        <li><a href="/slots">Browse Available Slots</a></li>
        <li><a href="/my-bookings">My Bookings</a></li>
      </ul>
    <% } else if (user.role === "admin") { %>
      <ul>
        <li><a href="/admin/users">Manage Users</a></li>
        <li><a href="/admin/bookings">View All Bookings</a></li>
      </ul>
    <% } %>

  </main>
</body>
</html>