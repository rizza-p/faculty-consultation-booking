<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Available Slots - Faculty Consultation Booking System</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="header-row">
      <h1>Available Consultation Slots</h1>
      <span class="brand">Faculty Consultation Booking System</span>
    </div>
  </header>

<div style="text-align:right; padding:1.5rem 2rem 0; background:transparent; box-shadow:none; border:none;">
  <input type="text" id="searchBox" placeholder="Search by faculty, department, or date..." style="width:300px; max-width:100%; padding:8px 12px; background:transparent; border:1px solid #888; border-radius:6px;">
</div>

  <main class="centered-main">

    <% if (slots.length === 0) { %>
      <p>No available slots right now.</p>
    <% } %>

    <% slots.forEach(function(slot) { %>
      <div class="slot-card" style="border: 1px solid #ccc; padding: 1rem; margin-bottom: 1rem;">
        <p><strong><%= slot.faculty_name %></strong> (<%= slot.department %>)</p>
        <p><%= new Date(slot.slot_date).toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %> | <%= formatTime(slot.start_time) %> - <%= formatTime(slot.end_time) %></p>

        <form action="/slots/<%= slot.id %>/book" method="POST">
          <label for="purpose-<%= slot.id %>">Purpose</label><br>
          <input type="text" id="purpose-<%= slot.id %>" name="purpose" required><br><br>
          <button type="submit">Book this slot</button>
        </form>
      </div>
    <% }); %>

    <p id="noResults" style="display:none; text-align:center;">No matching slots found.</p>

    <p><a href="/dashboard">Back to Dashboard</a></p>
  </main>

  <script>
    document.getElementById('searchBox').addEventListener('input', function () {
      const term = this.value.toLowerCase();
      const cards = document.querySelectorAll('.slot-card');
      let visible = 0;
      cards.forEach(function (card) {
        // search only the faculty and date text, not the purpose box or button
        const text = Array.from(card.querySelectorAll('p')).map(function (p) { return p.textContent; }).join(' ').toLowerCase();
        const match = text.includes(term);
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      // only show "no matching slots" when there are slots to search through
      document.getElementById('noResults').style.display = (cards.length > 0 && visible === 0) ? 'block' : 'none';
    });
  </script>
</body>
</html>