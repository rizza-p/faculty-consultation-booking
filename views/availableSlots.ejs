<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Available Slots - Faculty Consultation Booking System</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>Available Consultation Slots</h1>
  </header>

  <main>
    <% if (slots.length === 0) { %>
      <p>No available slots right now.</p>
    <% } %>

    <% slots.forEach(function(slot) { %>
      <div style="border: 1px solid #ccc; padding: 1rem; margin-bottom: 1rem;">
        <p><strong><%= slot.faculty_name %></strong> (<%= slot.department %>)</p>
        <p><%= slot.slot_date %> | <%= slot.start_time %> - <%= slot.end_time %></p>

        <form action="/slots/<%= slot.id %>/book" method="POST">
          <label for="purpose">Purpose</label><br>
          <input type="text" id="purpose" name="purpose" required><br><br>
          <button type="submit">Book this slot</button>
        </form>
      </div>
    <% }); %>

    <p><a href="/dashboard">Back to Dashboard</a></p>
  </main>
</body>
</html>