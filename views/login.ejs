<%- include("partials/header", { title }) %>
<section class="login-wrap">
  <div class="hero">
    <p class="eyebrow">CAMPUS SERVICES</p>
    <h1>Make time for meaningful conversations.</h1>
    <p>Request a consultation, coordinate schedules, and keep track of every booking in one place.</p>
    <div class="feature-pills"><span>Student requests</span><span>Faculty schedules</span><span>Clear status tracking</span></div>
  </div>
  <form class="panel login-panel" method="post" action="/login">
    <h2>Welcome back</h2>
    <p class="muted">Log in with your campus account.</p>
    <label for="email">Email address</label>
    <input id="email" type="email" name="email" required maxlength="190" autocomplete="username">
    <label for="password">Password</label>
    <input id="password" type="password" name="password" required maxlength="200" autocomplete="current-password">
    <button class="primary full" type="submit">Log in</button>
    <a class="secondary button full" href="/register">Create an account</a>
  </form>
</section>
<%- include("partials/footer") %>
