<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Create Slot - Faculty Consultation Booking System</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="header-row">
      <h1>Create a Consultation Slot</h1>
      <span class="brand">Faculty Consultation Booking System</span>
    </div>
  </header>

  <main class="centered-main">
    <% if (error) { %>
      <p style="color: red;"><%= error %></p>
    <% } %>

    <form action="/slots/new" method="POST">
      <label for="slot_date">Date</label><br>
      <input type="date" id="slot_date" name="slot_date" required><br><br>

      <label for="start_time">Start Time</label><br>
      <input type="time" id="start_time" name="start_time" required><br><br>

      <label for="end_time">End Time</label><br>
      <input type="time" id="end_time" name="end_time" required><br><br>

      <button type="submit">Create Slot</button>
    </form>

    <p><a href="/dashboard">Back to Dashboard</a></p>
  </main>
</body>
</html>