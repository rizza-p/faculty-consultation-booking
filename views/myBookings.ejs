<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Bookings - Faculty Consultation Booking System</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="header-row">
      <h1>My Bookings</h1>
      <span class="brand">Faculty Consultation Booking System</span>
    </div>
  </header>

  <div style="text-align:right; padding:1.5rem 2rem 0; background:transparent; box-shadow:none; border:none;">
    <input type="text" id="searchBox" placeholder="Search by faculty, date, or status..." style="width:300px; max-width:100%; padding:8px 12px; background:transparent; border:1px solid #888; border-radius:6px;">
  </div>

  <main class="centered-main">
    <% if (bookings.length === 0) { %>
      <p>You have no bookings yet.</p>
    <% } %>

    <% bookings.forEach(function(b) { %>
      <div class="slot-card" style="border: 1px solid #ccc; padding: 1rem; margin-bottom: 1rem;">
        <p><strong><%= b.faculty_name %></strong></p>
        <p><%= new Date(b.slot_date).toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %> | <%= formatTime(b.start_time) %> - <%= formatTime(b.end_time) %></p>
        <p>Purpose: <%= b.purpose %></p>
        <p>Status: <span class="status status-<%= b.status %>"><%= b.status %></span></p>

        <% if (b.status === "pending" || b.status === "approved") { %>
          <form action="/my-bookings/<%= b.id %>/cancel" method="POST" onsubmit="return confirm('Cancel this booking?');" style="width: fit-content; margin: 10px auto 0; background: transparent; border: none; padding: 0; box-shadow: none;">
            <button type="submit" style="padding:6px 16px; font-size:0.85rem;">Cancel</button>
          </form>
        <% } %>
      </div>
    <% }); %>

    <p id="noResults" style="display:none; text-align:center;">No matching bookings found.</p>

    <p><a href="/dashboard">Back to Dashboard</a></p>
  </main>

  <script>
    document.getElementById('searchBox').addEventListener('input', function () {
      const term = this.value.toLowerCase();
      const cards = document.querySelectorAll('.slot-card');
      let visible = 0;
      cards.forEach(function (card) {
        // search only the text lines, not the buttons
        const text = Array.from(card.querySelectorAll('p')).map(function (p) { return p.textContent; }).join(' ').toLowerCase();
        const match = text.includes(term);
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      document.getElementById('noResults').style.display = (cards.length > 0 && visible === 0) ? 'block' : 'none';
    });
  </script>
</body>
</html>