<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>All Bookings - Faculty Consultation Booking System</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="header-row">
      <h1>All Bookings</h1>
      <span class="brand">Faculty Consultation Booking System</span>
    </div>
  </header>

  <div style="text-align:right; padding:1.5rem 2rem 0; background:transparent; box-shadow:none; border:none;">
  <input type="text" id="searchBox" placeholder="Search by student, faculty, or status..." style="width:300px; max-width:100%; padding:8px 12px; background:transparent; border:1px solid #888; border-radius:6px;">
  </div>

  <main class="centered-main">

    <table border="1" cellpadding="8" cellspacing="0">
      <tr>
        <th>Student</th>
        <th>Faculty</th>
        <th>Date</th>
        <th>Time</th>
        <th>Purpose</th>
        <th>Status</th>
      </tr>
      <% bookings.forEach(function(b) { %>
        <tr>
          <td><%= b.student_name %></td>
          <td><%= b.faculty_name %></td>
          <td><%= new Date(b.slot_date).toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %></td>
          <td><%= formatTime(b.start_time) %> - <%= formatTime(b.end_time) %></td>
          <td><%= b.purpose %></td>
          <td><span class="status status-<%= b.status %>"><%= b.status %></span></td>
        </tr>
      <% }); %>
    </table>

    <p id="noResults" style="display:none; text-align:center;">No results found.</p>

    <p><a href="/dashboard">Back to Dashboard</a></p>
  </main>

  <script>
    document.getElementById('searchBox').addEventListener('input', function () {
      const term = this.value.toLowerCase();
      let visible = 0;
      document.querySelectorAll('table tr').forEach(function (row) {
        if (row.querySelector('th')) return; // keep the header row
        const match = row.textContent.toLowerCase().includes(term);
        row.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      document.getElementById('noResults').style.display = visible === 0 ? 'block' : 'none';
    });
  </script>
</body>
</html>