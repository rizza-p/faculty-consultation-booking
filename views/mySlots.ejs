<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Posted Slots - Faculty Consultation Booking System</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="header-row">
      <h1>My Posted Slots</h1>
      <span class="brand">Faculty Consultation Booking System</span>
    </div>
  </header>

  <div style="text-align:right; padding:1.5rem 2rem 0; background:transparent; box-shadow:none; border:none;">
    <input type="text" id="searchBox" placeholder="Search by date, student, or status..." style="width:300px; max-width:100%; padding:8px 12px; background:transparent; border:1px solid #888; border-radius:6px;">
  </div>

  <main class="centered-main">
    <% if (slots.length === 0) { %>
      <p>You haven't posted any slots yet.</p>
    <% } %>

    <% slots.forEach(function(slot) { %>
      <div class="slot-card" style="border: 1px solid #ccc; padding: 1rem; margin-bottom: 1rem;">
        <p><%= new Date(slot.slot_date).toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %> | <%= formatTime(slot.start_time) %> - <%= formatTime(slot.end_time) %></p>

        <% if (!slot.is_booked) { %>
          <p>Status: <span class="status status-approved">Open</span></p>
        <% } else if (slot.booking_status) { %>
          <p>Booked by <strong><%= slot.student_name %></strong></p>
          <p>Purpose: <%= slot.purpose %></p>
          <p>Status: <span class="status status-<%= slot.booking_status %>"><%= slot.booking_status %></span></p>
        <% } else { %>
          <p>Status: <span class="status status-cancelled">Unavailable</span></p>
        <% } %>

        <% if (!slot.is_booked) { %>
          <form action="/my-slots/<%= slot.id %>/cancel" method="POST" onsubmit="return confirm('Remove this slot?');" style="width: fit-content; margin: 10px auto 0; background: transparent; border: none; padding: 0; box-shadow: none;">
            <button type="submit" style="padding:6px 16px; font-size:0.85rem;">Remove</button>
          </form>
        <% } else if (slot.booking_status === "pending" || slot.booking_status === "approved") { %>
          <form action="/my-slots/<%= slot.id %>/cancel" method="POST" onsubmit="return confirm('Cancel this slot and the booking on it?');" style="width: fit-content; margin: 10px auto 0; background: transparent; border: none; padding: 0; box-shadow: none;">
            <button type="submit" style="padding:6px 16px; font-size:0.85rem;">Cancel slot</button>
          </form>
        <% } %>
      </div>
    <% }); %>

    <p id="noResults" style="display:none; text-align:center;">No matching slots found.</p>

    <p><a href="/slots/new">Post a New Slot</a></p>
    <p><a href="/dashboard">Back to Dashboard</a></p>
  </main>

  <script>
    document.getElementById('searchBox').addEventListener('input', function () {
      const term = this.value.toLowerCase();
      const cards = document.querySelectorAll('.slot-card');
      let visible = 0;
      cards.forEach(function (card) {
        // search only the text lines, not the buttons
        const text = Array.from(card.querySelectorAll('p')).map(function (p) { return p.textContent; }).join(' ').toLowerCase();
        const match = text.includes(term);
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      document.getElementById('noResults').style.display = (cards.length > 0 && visible === 0) ? 'block' : 'none';
    });
  </script>
</body>
</html>